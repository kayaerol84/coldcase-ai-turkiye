{
  "realm": "coldcase",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "coldcase-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "coldcase-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "coldcase-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "researcher",
      "email": "researcher@coldcase.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Researcher",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "researcher", "temporary": false }]
    },
    {
      "username": "reviewer",
      "email": "reviewer@coldcase.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Reviewer",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "reviewer", "temporary": false }]
    }
  ]
}
